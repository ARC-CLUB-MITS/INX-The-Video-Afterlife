MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=inx

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Step 4 — Gemini Free Tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Q&A provider (recommended for demos without Gemini quota)
# ollama = local model only; gemini = Gemini only; auto = Ollama first, then Gemini
QA_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=120

# Grounded Q&A safety gates
QA_MIN_RETRIEVAL_SCORE=0.58
QA_MAX_ANSWER_CHARS=1200


# Reliability — retry transient Gemini 429/503/high-demand failures
GEMINI_MAX_RETRIES=3
